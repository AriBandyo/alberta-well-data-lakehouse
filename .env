# Local project paths
PROJECT_ROOT=.
PUBLIC_SOURCE_DIR=data/source_snapshot
EXTERNAL_SOURCE_DIR=data/external
BRONZE_DIR=lakehouse/bronze
SILVER_DIR=lakehouse/silver
SILVER_EXPORT_DIR=warehouse/silver_exports
WAREHOUSE_DB_PATH=warehouse/alberta_well_analytics.duckdb
DBT_PROJECT_DIR=dbt/alberta_well_analytics
DBT_PROFILES_DIR=dbt/alberta_well_analytics
PUBLIC_FACT_CSV=warehouse/gold/fct_energy_activity.csv

# Spark configuration
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=8
SPARK_LOCAL_IP=127.0.0.1
PYSPARK_PYTHON=python
PYSPARK_DRIVER_PYTHON=python

# Free official source endpoints
REGIONAL_OIL_CSV_URL=https://regionaldashboard.alberta.ca/export/opendata/Oil%20Production/csvs
REGIONAL_GAS_CSV_URL=https://regionaldashboard.alberta.ca/export/opendata/Natural%20Gas%20Production/csvs
REGIONAL_WELL_COUNT_CSV_URL=https://regionaldashboard.alberta.ca/export/opendata/Well%20Count/csvs
AER_ST37_EXCEL_URL=https://static.aer.ca/prd/documents/sts/st37/ST_37_Excel.zip
AER_WELL_FEATURE_QUERY_URL=https://services2.arcgis.com/jQV6VMr2Loovu7GU/ArcGIS/rest/services/AB_Well_Licence_WebM/FeatureServer/0/query
PETRINEX_INFRA_API_TEMPLATE=https://www.petrinex.gov.ab.ca/publicdata/API/Files/{jurisdiction}/Infra/{filename}/{format}
PETRINEX_VOLUMETRIC_API_TEMPLATE=https://www.petrinex.gov.ab.ca/publicdata/API/Files/{jurisdiction}/Vol/{month}/{format}
HTTP_USER_AGENT=alberta-well-data-lakehouse/1.1
REQUEST_TIMEOUT_SECONDS=120
